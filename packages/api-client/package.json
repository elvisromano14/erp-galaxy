{
  "name": "@erp/api-client",
  "version": "0.1.0",
  "description": "Cliente tipado de la API del Mini ERP, generado desde OpenAPI (web, móvil u otros clientes).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.0",
    "typescript": "^5.6.0"
  }
}
