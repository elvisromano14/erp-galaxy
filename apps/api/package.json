{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "ts-node --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:reset": "bash scripts/db-reset.sh",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand --config jest.e2e.config.js",
    "db:migrate": "bash -c 'set -a; . ./.env; set +a; DATABASE_URL=$MIGRATION_DATABASE_URL prisma migrate deploy'",
    "openapi:export": "ts-node --transpile-only scripts/export-openapi.ts",
    "worker": "ts-node --transpile-only src/worker.ts",
    "start:worker": "node dist/worker.js",
    "bootstrap:prod": "node dist/cli/bootstrap.js",
    "db:migrate:prod": "prisma migrate deploy"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@erp/domain": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "multer": "^2.4.0",
    "nestjs-pino": "^4.4.0",
    "nestjs-zod": "4.3.1",
    "pdfmake": "^0.3.11",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^6.0.2",
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
