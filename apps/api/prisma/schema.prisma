  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  number          String
  status          String    @default("CONFIRMED")
  customerId      String    @map("customer_id") @db.Uuid
  receiptDate     DateTime  @map("receipt_date") @db.Date
  paymentMethodId String    @map("payment_method_id") @db.Uuid
  bankAccountId   String?   @map("bank_account_id") @db.Uuid
  currencyId      String    @map("currency_id") @db.Uuid
  exchangeRate    Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  amount          Decimal   @db.Decimal(18, 4)
  igtfPct         Decimal   @default(0) @map("igtf_pct") @db.Decimal(7, 4)
  igtfAmount      Decimal   @default(0) @map("igtf_amount") @db.Decimal(18, 4)
  reference       String?
  notes           String?
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  cancelReason    String?   @map("cancel_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy       String?   @map("created_by") @db.Uuid

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, customerId, receiptDate])
  @@map("customer_receipts")
}

model CustomerReceiptApplication {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId         String  @map("company_id") @db.Uuid
  receiptId         String  @map("receipt_id") @db.Uuid
  receivableEntryId String  @map("receivable_entry_id") @db.Uuid
  amount            Decimal @db.Decimal(18, 4)
  amountReceipt     Decimal @map("amount_receipt") @db.Decimal(18, 4)
  rateDoc           Decimal? @map("rate_doc") @db.Decimal(18, 8)
  ratePay           Decimal? @map("rate_pay") @db.Decimal(18, 8)
  fxDiffBs          Decimal @default(0) @map("fx_diff_bs") @db.Decimal(18, 4)

  @@unique([companyId, receiptId, receivableEntryId])
  @@index([companyId, receivableEntryId])
  @@map("customer_receipt_applications")
}

model SalesDocumentPayment {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  paymentMethodId String   @map("payment_method_id") @db.Uuid
  bankAccountId   String?  @map("bank_account_id") @db.Uuid
  currencyId      String   @map("currency_id") @db.Uuid
  exchangeRate    Decimal  @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  amount          Decimal  @db.Decimal(18, 4)
  amountDoc       Decimal  @map("amount_doc") @db.Decimal(18, 4)
  appliesIgtf     Boolean  @default(false) @map("applies_igtf")
  igtfAmount      Decimal  @default(0) @map("igtf_amount") @db.Decimal(18, 4)
  reference       String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId, documentId])
  @@map("sales_document_payments")
}

/// Retenciones de IVA/ISLR. ISSUED = las practicamos a un proveedor (reducen la CxP); RECEIVED = nos las practica un cliente (reducen la CxC).
model Withholding {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  direction          String
  kind               String
  number             String
  externalNumber     String?   @map("external_number")
  status             String    @default("CONFIRMED")
  voucherDate        DateTime  @map("voucher_date") @db.Date
  period             String
  supplierId         String?   @map("supplier_id") @db.Uuid
  customerId         String?   @map("customer_id") @db.Uuid
  purchaseDocumentId String?   @map("purchase_document_id") @db.Uuid
  salesDocumentId    String?   @map("sales_document_id") @db.Uuid
  payableEntryId     String?   @map("payable_entry_id") @db.Uuid
  receivableEntryId  String?   @map("receivable_entry_id") @db.Uuid
  concept            String?
  baseBs             Decimal   @map("base_bs") @db.Decimal(18, 4)
  percentage         Decimal   @db.Decimal(7, 4)
  amountBs           Decimal   @map("amount_bs") @db.Decimal(18, 4)
  appliedAmount      Decimal   @map("applied_amount") @db.Decimal(18, 4)
  notes              String?
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledBy        String?   @map("cancelled_by") @db.Uuid
  cancelReason       String?   @map("cancel_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy          String?   @map("created_by") @db.Uuid

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, direction, kind, period])
  @@map("withholdings")
}

/// Exportación de un reporte pesado procesada en segundo plano (cola `reports` de BullMQ).
model ReportJob {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  category   String
  report     String
  format     String
  delimiter  String    @default(";")
  filters    Json      @default("{}")
  status     String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | EXPIRED
  error      String?
  rowCount   Int?      @map("row_count")
  truncated  Boolean   @default(false)
  filename   String?
  mime       String?
  sizeBytes  Int?      @map("size_bytes")
  file       Bytes?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  startedAt  DateTime? @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz

  @@unique([companyId, id])
  @@index([companyId, userId, createdAt])
  @@map("report_jobs")
}
