{
  "name": "mini-erp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.10.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @erp/api dev",
    "db:up": "podman-compose -f docker-compose.dev.yml up -d",
    "db:down": "podman-compose -f docker-compose.dev.yml down"
  }
}
